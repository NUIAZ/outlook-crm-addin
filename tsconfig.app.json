{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    /* `vite/client` supplies the ambient module declarations for CSS and asset imports;
       `vitest/globals` supplies describe/it/expect without importing them everywhere. */
    "types": ["vitest/globals", "vite/client", "node"],

    /* Strictness. `any` is banned outright; the slice of Office.js this add-in uses is
       typed by hand in src/office/office.d.ts instead of being cast away. */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "tests", "vitest.setup.ts"]
}
